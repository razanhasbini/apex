# Server-side only (server.js). Never prefix these with VITE_.
RESEND_API_KEY=
CONTACT_TO=info@example.com
CONTACT_FROM="Website <noreply@example.com>"
# Comma-separated list of origins allowed to call /api/contact
ALLOWED_ORIGIN=http://localhost:5173
PORT=5000

# Frontend (public, baked into the bundle at build time)
VITE_CONTACT_API_URL=http://localhost:5000
